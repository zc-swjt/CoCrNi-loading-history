+void Integrate::parse_move_field(const char** param, int num_param, std::vector<Group>& group)
+{
+  if (num_param != 2 && num_param != 3) {
+    PRINT_INPUT_ERROR("Keyword 'move_field' should have 1 or 2 parameters.");
+  }
+  if (group.size() < 1) {
+    PRINT_INPUT_ERROR("Cannot use 'move_field' without a grouping method.");
+  }
+
+  int gid_index = 1;
+  if (num_param == 3) {
+    if (!is_valid_int(param[1], &field_move_grouping_method)) {
+      PRINT_INPUT_ERROR("Grouping method for 'move_field' should be an integer.");
+    }
+    gid_index = 2;
+  } else {
+    field_move_grouping_method = 0;
+  }
+  if (field_move_grouping_method < 0 || field_move_grouping_method >= group.size()) {
+    PRINT_INPUT_ERROR("Grouping method for 'move_field' is out of range.");
+  }
+  if (!is_valid_int(param[gid_index], &field_move_group)) {
+    PRINT_INPUT_ERROR("Field-moving group ID should be an integer.");
+  }
+  if (field_move_group < 0 || field_move_group >= group[field_move_grouping_method].number) {
+    PRINT_INPUT_ERROR("Field-moving group ID is out of range.");
+  }
+  printf(
+    "Group %d in grouping method %d will follow its input per-atom velocity field.\n",
+    field_move_group,
+    field_move_grouping_method);
+}
